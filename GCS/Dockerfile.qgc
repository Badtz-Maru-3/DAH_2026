FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV QGC_APPIMAGE_URL=https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    fuse \
    libfuse2 \
    libxcb-xinerama0 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-cursor-dev \
    libgl1 \
    libopengl0 \
    libglib2.0-0 \
    libfontconfig1 \
    libdbus-1-3 \
    libpulse0 \
    libsdl2-2.0-0 \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-gl \
    python3-gi \
    python3-gst-1.0 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash qgc \
    && mkdir -p /opt/qgc \
    && wget -O /opt/qgc/QGroundControl.AppImage "$QGC_APPIMAGE_URL" \
    && chmod +x /opt/qgc/QGroundControl.AppImage \
    && chown -R qgc:qgc /opt/qgc

USER qgc
WORKDIR /home/qgc

ENTRYPOINT ["/opt/qgc/QGroundControl.AppImage", "--appimage-extract-and-run"]
