ROS_DOMAIN_ID=17
ROBOT_MODEL=rosbot_xl
ROBOT_CONFIGURATION=autonomy
QGC_IP=127.0.0.1
QGC_PORT=14550
LIBGL_ALWAYS_SOFTWARE=1

# Bridge
BRIDGE_LOCAL_PORT=14551
MAV_SYS_ID=1
MAV_COMP_ID=1
MAX_LINEAR=0.5
MAX_ANGULAR=1.2
CMD_TIMEOUT=0.6
BASE_LAT=37.5665
BASE_LON=126.9780
BASE_ALT=50.0
MAVLINK_DEBUG=0

# Mission audit
MISSION_AUDIT_LOG=/logs/mission_audit.log
MISSION_MAX_ITEMS=20
MISSION_GEOFENCE_RADIUS_M=300
MISSION_MAX_JUMP_M=120
MISSION_MIN_ALT_M=-20
MISSION_MAX_ALT_M=200
MISSION_ALLOWED_COMMANDS=16,20

# GNSS integrity
GNSS_INTEGRITY_LOG=/logs/gnss_integrity.log
GNSS_MAX_RESIDUAL_M=30
GNSS_MIN_FIX_TYPE=3
GNSS_MIN_SATELLITES=6
GNSS_MAX_HACC_M=15

# Correlation Engine
CORRELATION_LOG=/logs/correlation_event.log
CORRELATION_SIGNAL_TTL_S=20
CORRELATION_RISK_THRESHOLD=0.75
CORRELATION_HOLD_SECONDS=5
CORRELATION_WEIGHT_MISSION_REJECTED=0.75
CORRELATION_WEIGHT_GNSS_REJECTED=0.75
CORRELATION_WEIGHT_HIGH_COMMAND=0.35
COMMAND_HIGH_LINEAR_MPS=0.60
COMMAND_HIGH_ANGULAR_RADPS=1.50
